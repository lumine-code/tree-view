{
  "menu": [
    {
      "label": "View",
      "submenu": [
        {
          "label": "Toggle View",
          "submenu": [
            {
              "label": "Tree View",
              "command": "tree-view:toggle",
              "group": "panels",
              "order": 10
            }
          ]
        }
      ]
    },
    {
      "label": "Packages",
      "submenu": [
        {
          "label": "Tree View",
          "submenu": [
            {
              "label": "Focus",
              "command": "tree-view:toggle-focus"
            },
            {
              "label": "Toggle",
              "command": "tree-view:toggle"
            },
            {
              "label": "Reveal Active File",
              "command": "tree-view:reveal-active-file"
            },
            {
              "label": "Toggle Tree Side",
              "command": "tree-view:toggle-side"
            }
          ]
        }
      ]
    }
  ],
  "context-menu": {
    ".tree-view .full-menu": {
      "groupOrder": [
        "opening",
        "layout",
        "entries",
        "clipboard",
        "favourites",
        "tools",
        "extensions",
        "paths",
        "projects",
        "delete"
      ],
      "items": []
    },
    ".tree-view .multi-select": {
      "groupOrder": [
        "opening",
        "layout",
        "entries",
        "clipboard",
        "favourites",
        "tools",
        "extensions",
        "paths",
        "projects",
        "delete"
      ],
      "items": []
    },
    ".tree-view .full-menu .file": [
      {
        "label": "Open",
        "command": "tree-view:open-selected-entry",
        "group": "opening",
        "order": 10
      }
    ],
    ".tree-view .full-menu .directory.collapsed": [
      {
        "label": "Expand",
        "command": "tree-view:open-selected-entry",
        "group": "opening",
        "order": 10
      }
    ],
    ".tree-view .full-menu .directory.expanded": [
      {
        "label": "Collapse",
        "command": "tree-view:open-selected-entry",
        "group": "opening",
        "order": 10
      }
    ],
    ".tree-view .full-menu:not(.special-select)": [
      {
        "type": "separator"
      },
      {
        "label": "New File…",
        "command": "tree-view:add-file",
        "group": "entries",
        "order": 10
      },
      {
        "label": "New Folder…",
        "command": "tree-view:add-folder",
        "group": "entries",
        "order": 20
      },
      {
        "type": "separator"
      },
      {
        "label": "Rename…",
        "command": "tree-view:move",
        "afterGroupContaining": ["tree-view:add-file"],
        "group": "entries",
        "order": 30
      },
      {
        "label": "Duplicate…",
        "command": "tree-view:duplicate",
        "group": "entries",
        "order": 40
      },
      {
        "label": "Delete",
        "command": "tree-view:remove",
        "group": "delete",
        "order": 10
      },
      { "type": "separator" },
      {
        "label": "Cut",
        "command": "tree-view:cut",
        "afterGroupContaining": ["tree-view:remove", "tree-view:add-file"],
        "group": "clipboard",
        "order": 10
      },
      {
        "label": "Copy",
        "command": "tree-view:copy",
        "group": "clipboard",
        "order": 20
      },
      {
        "label": "Paste",
        "command": "tree-view:paste",
        "group": "clipboard",
        "order": 30
      },
      {
        "type": "separator"
      },
      {
        "label": "Add Project Folder…",
        "command": "application:add-project-folder",
        "afterGroupContaining": [
          {
            "id": "fast-publish:tree-context"
          },
          "folder-sync:create",
          "folder-sync:run",
          {
            "id": "terminal:tree-context"
          },
          "tree-view-favourite:add",
          "tree-view-favourite:remove",
          "diff-view:enable",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "group": "projects",
        "order": 10
      },
      {
        "type": "separator"
      },
      {
        "label": "Copy Full Path",
        "command": "tree-view:copy-full-path",
        "afterGroupContaining": ["application:add-project-folder"],
        "group": "paths",
        "order": 10
      },
      {
        "label": "Copy Project Path",
        "command": "tree-view:copy-project-path",
        "group": "paths",
        "order": 20
      },
      {
        "type": "separator"
      }
    ],
    ".tree-view .full-menu .tree-view-special-entry": [
      {
        "type": "separator"
      },
      {
        "label": "Copy Full Path",
        "command": "tree-view:copy-full-path",
        "group": "paths",
        "order": 10
      },
      {
        "type": "separator"
      }
    ],
    ".tree-view .full-menu [is=\"tree-view-file\"]": [
      {
        "type": "separator"
      },
      {
        "label": "Split Up",
        "command": "tree-view:open-selected-entry-up",
        "afterGroupContaining": [
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "group": "layout",
        "order": 10
      },
      {
        "label": "Split Down",
        "command": "tree-view:open-selected-entry-down",
        "group": "layout",
        "order": 20
      },
      {
        "label": "Split Left",
        "command": "tree-view:open-selected-entry-left",
        "group": "layout",
        "order": 30
      },
      {
        "label": "Split Right",
        "command": "tree-view:open-selected-entry-right",
        "group": "layout",
        "order": 40
      },
      {
        "type": "separator"
      }
    ],
    ".tree-view .full-menu .project-root:not(.tree-view-special-root) > .header": [
      {
        "type": "separator"
      },
      {
        "label": "New File…",
        "command": "tree-view:add-file",
        "group": "entries",
        "order": 10
      },
      {
        "label": "New Folder…",
        "command": "tree-view:add-folder",
        "group": "entries",
        "order": 20
      },
      {
        "type": "separator"
      },
      {
        "label": "Rename…",
        "command": "tree-view:move",
        "afterGroupContaining": ["tree-view:add-file"],
        "group": "entries",
        "order": 30
      },
      {
        "label": "Duplicate…",
        "command": "tree-view:duplicate",
        "group": "entries",
        "order": 40
      },
      {
        "label": "Delete",
        "command": "tree-view:remove",
        "group": "delete",
        "order": 10
      },
      { "type": "separator" },
      {
        "label": "Cut",
        "command": "tree-view:cut",
        "afterGroupContaining": ["tree-view:remove", "tree-view:add-file"],
        "group": "clipboard",
        "order": 10
      },
      {
        "label": "Copy",
        "command": "tree-view:copy",
        "group": "clipboard",
        "order": 20
      },
      {
        "label": "Paste",
        "command": "tree-view:paste",
        "group": "clipboard",
        "order": 30
      },
      {
        "type": "separator"
      },
      {
        "label": "Add Project Folder…",
        "command": "application:add-project-folder",
        "afterGroupContaining": [
          {
            "id": "fast-publish:tree-context"
          },
          "folder-sync:create",
          "folder-sync:run",
          {
            "id": "terminal:tree-context"
          },
          "tree-view-favourite:add",
          "tree-view-favourite:remove",
          "diff-view:enable",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "group": "projects",
        "order": 10
      },
      {
        "label": "Remove Project Folder",
        "command": "tree-view:remove-project-folder",
        "group": "projects",
        "order": 20
      },
      {
        "label": "Collapse All Project Folders",
        "command": "tree-view:collapse-all",
        "group": "projects",
        "order": 30
      },
      {
        "type": "separator"
      },
      {
        "label": "Copy Full Path",
        "command": "tree-view:copy-full-path",
        "afterGroupContaining": ["application:add-project-folder"],
        "group": "paths",
        "order": 10
      },
      // A project folder's path relative to itself is the empty string, so the
      // item has nothing to copy here. It is hidden rather than dropped: the
      // whole-tree menu above contributes it to every right-click inside the
      // list, and only an item the root claims first can suppress that one.
      {
        "label": "Copy Project Path",
        "command": "tree-view:copy-project-path",
        "visible": false,
        "group": "paths",
        "order": 20
      },
      {
        "type": "separator"
      }
    ],
    ".tree-view .multi-select:not(.special-select)": [
      {
        "type": "separator"
      },
      {
        "label": "Delete",
        "command": "tree-view:remove",
        "group": "delete",
        "order": 10
      },
      { "type": "separator" },
      {
        "label": "Cut",
        "command": "tree-view:cut",
        "afterGroupContaining": ["tree-view:remove", "tree-view:add-file"],
        "group": "clipboard",
        "order": 10
      },
      {
        "label": "Copy",
        "command": "tree-view:copy",
        "group": "clipboard",
        "order": 20
      },
      {
        "label": "Paste",
        "command": "tree-view:paste",
        "group": "clipboard",
        "order": 30
      },
      {
        "type": "separator"
      },
      {
        "label": "Copy Full Path",
        "command": "tree-view:copy-full-path",
        "afterGroupContaining": [
          "tree-view:remove-project-folder",
          {
            "id": "fast-publish:tree-context"
          },
          "folder-sync:create",
          "folder-sync:run",
          {
            "id": "terminal:tree-context"
          },
          "tree-view-favourite:add",
          "tree-view-favourite:remove",
          "diff-view:enable",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "group": "paths",
        "order": 10
      },
      {
        "label": "Copy Project Path",
        "command": "tree-view:copy-project-path",
        "group": "paths",
        "order": 20
      },
      {
        "type": "separator"
      }
    ],
    ".tree-view .multi-select.all-roots-selected": [
      {
        "type": "separator"
      },
      {
        "label": "Remove Project Folders",
        "command": "tree-view:remove-project-folder",
        "afterGroupContaining": [
          {
            "id": "fast-publish:tree-context"
          },
          "folder-sync:create",
          "folder-sync:run",
          {
            "id": "terminal:tree-context"
          },
          "tree-view-favourite:add",
          "tree-view-favourite:remove",
          "diff-view:enable",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "group": "projects",
        "order": 20
      },
      {
        "type": "separator"
      }
    ],
    "lumine-pane[data-active-item-path] .tab.active": [
      {
        "type": "separator"
      },
      {
        "label": "Rename File…",
        "command": "tree-view:rename",
        "after": ["open-external:show"],
        "before": ["diff-view:enable"],
        "afterGroupContaining": [
          "pane:detach",
          "pane:close",
          "tabs:detach-tab",
          "tabs:open-in-new-window",
          "tabs:split-up",
          "tabs:close-tab"
        ],
        "group": "extensions",
        "order": 20
      },
      {
        "type": "separator"
      }
    ]
  }
}
